{"about": "The library: strings, lists, objects, nulls, formatting.",
 "cases": [
  {"expr": "s.lower().strip()", "record": {"s": "  The Lighthouse "}, "expect": "the lighthouse"},
  {"expr": "s.startswith(\"The\")", "record": {"s": "The end"}, "expect": true},
  {"expr": "s.split()", "record": {"s": "a  b c"}, "expect": ["a", "b", "c"]},
  {"expr": "\", \".join(xs)", "record": {"xs": ["a", "b"]}, "expect": "a, b"},
  {"expr": "str(1.0)", "expect": "1.0"},
  {"expr": "str(1e16)", "expect": "1e+16"},
  {"expr": "str(0.0001)", "expect": "0.0001"},
  {"expr": "str(0.00001)", "expect": "1e-05"},
  {"expr": "str(True)", "expect": "True"},
  {"expr": "str(None)", "expect": "None"},
  {"expr": "str([1, \"a\"])", "expect": "[1, 'a']"},
  {"expr": "format(p, \".3f\")", "record": {"p": 0.12345}, "expect": "0.123"},
  {"expr": "format(0.25, \".1%\")", "expect": "25.0%"},
  {"expr": "format(1234567, \",\")", "expect": "1,234,567"},
  {"expr": "format(0.000123, \".2g\")", "expect": "0.00012"},
  {"expr": "format(123456789.0, \".3g\")", "expect": "1.23e+08"},
  {"expr": "sum([1, 2, 3])", "expect": 6},
  {"expr": "sum([0.1] * 3)", "expect_error": "type"},
  {"expr": "sum([0.1, 0.2, 0.3])", "expect": 0.6},
  {"expr": "sum([1e100, 1.0, -1e100])", "expect": 1.0},
  {"expr": "min([3, 1, 2])", "expect": 1},
  {"expr": "max(2, 5)", "expect": 5},
  {"expr": "max([1, None])", "expect": null},
  {"expr": "min([])", "expect_error": "range"},
  {"expr": "any([False, None, True])", "expect": true},
  {"expr": "all([True, None])", "expect": null},
  {"expr": "sorted([3, 1, 2], reverse=True)", "expect": [3, 2, 1]},
  {"expr": "first([])", "expect": null},
  {"expr": "coalesce(None, 0, 1)", "expect": 0},
  {"expr": "d.get(\"k\", \"none\")", "record": {"d": {}}, "expect": "none"},
  {"expr": "{\"attn\": \"its attention only\"}.get(removed, \"error\")", "record": {"removed": "mlp"}, "expect": "error"},
  {"expr": "has(d, \"k\")", "record": {"d": {"k": null}}, "expect": true},
  {"expr": "exp(1)", "expect": 2.7182818284590455, "note": "musl's exp, one unit in the last place above the correctly rounded 2.718281828459045; the same bits on every host"},
  {"expr": "log(8, 2)", "expect": 3.0},
  {"expr": "log10(1000)", "expect": 3.0},
  {"expr": "sqrt(2)", "expect": 1.4142135623730951},
  {"expr": "nope(1)", "expect_error": "name"},
  {"expr": "s.nope()", "record": {"s": "x"}, "expect_error": "name"}
 ]}

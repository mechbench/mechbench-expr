{"about": "Numbers: integers stay integers, `/` is always float, `//` and `%` floor as Python does, overflow is an error, undefined numbers are null and counted.",
 "cases": [
  {"expr": "1 + 2", "expect": 3},
  {"expr": "7 / 2", "expect": 3.5},
  {"expr": "4 / 2", "expect": 2.0},
  {"expr": "7 // 2", "expect": 3},
  {"expr": "-7 // 2", "expect": -4},
  {"expr": "7 // -2", "expect": -4},
  {"expr": "-7 % 2", "expect": 1},
  {"expr": "7 % -2", "expect": -1},
  {"expr": "-7.5 // 2", "expect": -4.0},
  {"expr": "7.5 % -2", "expect": -0.5},
  {"expr": "2 ** 10", "expect": 1024},
  {"expr": "2 ** -1", "expect": 0.5},
  {"expr": "-2 ** 2", "expect": -4},
  {"expr": "2 ** 3 ** 2", "expect": 512},
  {"expr": "9223372036854775807 + 1", "expect_error": "range"},
  {"expr": "2 ** 63", "expect_error": "range"},
  {"expr": "1 / 0", "expect": null, "undefined": {"division by zero": 1}},
  {"expr": "1 // 0", "expect": null, "undefined": {"division by zero": 1}},
  {"expr": "5 % 0", "expect": null, "undefined": {"modulo by zero": 1}},
  {"expr": "log(0)", "expect": null, "undefined": {"the log of zero or a negative number": 1}},
  {"expr": "sqrt(-1)", "expect": null, "undefined": {"the square root of a negative number": 1}},
  {"expr": "0 ** -1", "expect": null, "undefined": {"zero to a negative power": 1}},
  {"expr": "(-8) ** 0.5", "expect": null, "undefined": {"a negative number to a fractional power": 1}},
  {"expr": "1e308 * 10", "expect": null, "undefined": {"a result too large for a number": 1}},
  {"expr": "0.1 + 0.2", "expect": 0.30000000000000004},
  {"expr": "x + 1", "record": {}, "expect": null},
  {"expr": "x * 2", "record": {"x": null}, "expect": null},
  {"expr": "\"a\" + \"b\"", "expect": "ab"},
  {"expr": "[1] + [2, 3]", "expect": [1, 2, 3]},
  {"expr": "\"a\" + 1", "expect_error": "type"},
  {"expr": "True + 1", "expect_error": "type"},
  {"expr": "-x", "record": {"x": 3}, "expect": -3},
  {"expr": "abs(-2.5)", "expect": 2.5}
 ]}

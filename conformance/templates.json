{"about": "Templates interpolate expressions in braces, with an optional number format; `{{` and `}}` are braces.",
 "cases": [
  {"template": "Write a two-sentence story about {animal}.", "record": {"animal": "a heron"}, "expect": "Write a two-sentence story about a heron."},
  {"template": "{coords.fact}: {round(p, 3)}", "record": {"coords": {"fact": "france"}, "p": 0.12345}, "expect": "france: 0.123"},
  {"template": "{p:.1%} of {n:,}", "record": {"p": 0.5, "n": 12000}, "expect": "50.0% of 12,000"},
  {"template": "{{literal}} {x}", "record": {"x": 1}, "expect": "{literal} 1"},
  {"template": "{xs[1:3]}", "record": {"xs": [1, 2, 3]}, "expect": "[2, 3]"},
  {"template": "{\"a\" if c else \"b\"}", "record": {"c": true}, "expect": "a"},
  {"template": "{missing}", "record": {}, "expect": "None"},
  {"template": "open {", "expect_error": "syntax"},
  {"template": "close }", "expect_error": "syntax"}
 ]}
